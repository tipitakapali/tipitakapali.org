PORT=5000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- Visitor log (GET /log) ---------------------------------------------------
# Optional ipinfo.io token for country/city resolution of visitor IPs.
# Free at https://ipinfo.io/ — without a token only anonymous JSON (rate-limited).
# IPINFO_TOKEN=your_ipinfo_token
# Optional custom path for the visitor log database (default: <server_api>/logs.db)
# LOGS_DB_PATH=/var/lib/tipitaka/logs.db
